# Supabase Project Configuration (Required)
# Configure these values in the Secrets panel in AI Studio.
# Only use the public/publishable anon key — NEVER put the service_role key here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: Google Web Client ID for native Android Credential Manager Google Sign-In.
# Browser OAuth PKCE via Supabase Auth works even if this is left as placeholder.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
